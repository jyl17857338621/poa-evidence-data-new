<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\poa-net.exe"
                  hostingModel="outofprocess"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  arguments="">
        <environmentVariables>
          <!-- 应用监听端口（IIS 通过 ARR 反向代理转发到此端口） -->
          <environmentVariable name="PORT" value="5000" />
          <!-- 数据/前端/上传目录根：指向含 data、uploads、public 的目录 -->
          <environmentVariable name="POA_ROOT" value="C:\path\to\amazon-poa-evidence" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
